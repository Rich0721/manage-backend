# Local Docker Compose infrastructure only. Override every credential in production.
POSTGRES_USER=progresql
POSTGRES_PASSWORD=progresql
POSTGRES_DB=progresql
POSTGRES_PORT=5432

REDIS_PASSWORD=progresql
REDIS_PORT=6379

# Host-process URLs. Containers must use the service-DNS URLs documented in README.md.
DATABASE_URL=postgresql://progresql:progresql@localhost:5432/progresql
REDIS_URL=redis://:progresql@localhost:6379/0

# Host-process integration test URLs.
INTEGRATION_DATABASE_URL=postgresql://progresql:progresql@127.0.0.1:5432/progresql?connect_timeout=5
INTEGRATION_REDIS_URL=redis://:progresql@127.0.0.1:6379/0
